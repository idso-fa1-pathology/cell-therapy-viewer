{
  "name": "dual-slide-pathology-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": ".venv/bin/python server.py",
    "prepare:data": ".venv/bin/python server.py --prepare-only",
    "test": "node --test tests/*.test.js && .venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "openseadragon": "6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^7.3.1"
  }
}
