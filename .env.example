# Host directory containing cases and/or groups of case folders.
DATA_DIR=./data
VIEWER_PORT=8000

# Optional subdirectories relative to EVERY case folder.
# "." means files are directly in that case folder.
HE_SLIDE_SUBDIR=.
IHC_SLIDE_SUBDIR=.
HE_MASK_SUBDIR=.
IHC_ANNOTATIONS_SUBDIR=.

# Optional exact file paths relative to each case. {slide} is the case folder
# name (the last part of the URL). A nonempty PATH overrides that role's SUBDIR.
HE_SLIDE_PATH=
IHC_SLIDE_PATH=
HE_MASK_PATH=
IHC_ANNOTATIONS_PATH=

# For the cohort/slide layout on rapuplabgpu04, see .env.ping.example.

# Example for slides/ and results/ within each case:
# HE_SLIDE_SUBDIR=slides
# IHC_SLIDE_SUBDIR=slides
# HE_MASK_SUBDIR=results/masks
# IHC_ANNOTATIONS_SUBDIR=results/annotations

# Outside the institutional network, uncomment to disable the default proxy:
# VIEWER_PROXY=
